#!/bin/bash
# The commissioning test of decisions 0075 and 0076: make a machine from a
# template or an ISO as an operator does, on a Proxmox host, and check that
# its first boot, its questions and its passwords work; for a cloud mode,
# make every node of it on its own site and check them together.
#
# usage: keel-commission --check CONTRACT
#        keel-commission --contract CONTRACT --vmid N --pass PASS --site NAME
#                        --out DIR [--template VOLID] [--iso VOLID] [--keep]
#
#   --check      only read the contract (tests/commission.yaml of the
#                appliance) and say whether it is valid
#   --template   the template volume on the PVE host, for example
#                local:vztmpl/debian-13-keel-wordpress_19.0-12_amd64.tar.zst
#   --iso        the ISO volume on the PVE host, for example
#                local:iso/keel-mariadb-19.0-trixie-amd64.iso
#   --vmid       a free container or VM id; one that exists is never
#                touched. The nodes of a cloud mode take N, N+1, N+2.
#   --pass       lxc-interactive: nothing preseeded, a root login answers
#                keel-init with the contract's answers (--template);
#                lxc-preseed: the contract's instance description is put in
#                the machine before its first boot, and no question may be
#                left for keel-init (--template);
#                vm-iso: a VM boots the ISO, the installer and the first
#                boot of the disk are answered on its screen (--iso);
#                cloud_simple, cloud_advanced: every node of that mode in
#                the contract's nodes, then the checks across them (a node
#                without an image of its own takes --template or --iso).
#                The meta of the pass names the sha256 of the image of
#                this appliance's nodes, which must be one image on every
#                site; each node's meta names its image and sha256
#   --site       the site name written in the record (br1, br2)
#   --out        where the record goes: DIR/PASS/record.tsv, meta, the
#                console transcript, the screens, and DIR/guide.md
#   --keep       leave the machines after the run, to look at them
#
# Environment:
#   KC_PVE              the command that reaches the PVE host (required for
#                       a pass), e.g. "ssh -o BatchMode=yes root@pve1";
#                       KC_PVE_<SITE> for a node on that site (KC_PVE_BR2)
#   KC_CT_OPTS          more pct create options: storage, network, memory
#   KC_IMAGE_<NODE>     the image of that node (KC_IMAGE_WITNESS), in place
#                       of the contract's; a node with the contract of
#                       another appliance needs one of the two
#   KC_VM_OPTS          more qm create options: the network, for example
#                       "--net0 virtio,bridge=vmbr0,tag=88"
#   KC_VM_STORAGE       the storage of the VM's disk (local-lvm)
#   KC_VM_FIRMWARE      auto (by the ISO), seabios or ovmf
#                       (each of the four with _<SITE> for a node's site)
#   KC_BOOT_TIMEOUT     seconds to wait for the first boot (900)
#   KC_NODE_WAIT        seconds a node of a cloud pass waits for another
#                       node: for the invite of the first node, and on a
#                       screen of cloud.waits (3600)
#   KC_MAIL_WAIT        seconds to wait before the mail check (600)
#   KC_CONSOLE_TIMEOUT  seconds of no change before Enter (6)
#   KC_CONSOLE_STEPS    Enters before the console is stuck (90)
#   KC_TUNNEL           the command that opens the SOCKS tunnel of the web
#                       screenshots with -N -D PORT (KC_PVE)
#   KC_NAMESERVER       the resolvers of a container, addresses with spaces
#                       (KC_NAMESERVER_<SITE> for a site); none: the PVE host's.
#                       A site with no IPv4 for its containers (the test net
#                       of BR1) needs IPv6 resolvers here, for example
#                       KC_NAMESERVER_BR1="2606:4700:4700::1111 2001:4860:4860::8888"
#   KC_NTFY_URL         a cloud pass: the ntfy topic URL its alerts go to; the
#                       pass appends "-VMID-EPOCH", so it reads only its own
#   KC_NTFY_TOKEN_FILE  the publish token of that server (mode 600), which
#                       each node gets as a secret file; never printed
#   KC_NTFY_READ_FILE   a header line that may read the topic, for example
#                       "Authorization: Bearer tk_..." (mode 600), for the
#                       checks with an alert
#   KC_CURL             the curl that reads the topic (curl)
#   KC_ALERT_POLL       seconds between two reads of the topic (5)
#
# Exit: 0 every check passed, 1 a check failed, 2 usage or an invalid
# contract, 3 the PVE host did not make or start the machine, 4 the vmid
# is in use.
#
# The secrets are made fresh for each run, are never the defaults and are
# never written to the record, the screens or the guide: they say which
# login worked, not with what.
set -uo pipefail

KC_LIB="$(cd "$(dirname "$0")/../lib/commission" && pwd)"
# shellcheck source=lib/commission/pve.sh
. "$KC_LIB/pve.sh"
# shellcheck source=lib/commission/console.sh
. "$KC_LIB/console.sh"
# shellcheck source=lib/commission/checks.sh
. "$KC_LIB/checks.sh"
# shellcheck source=lib/commission/vm.sh
. "$KC_LIB/vm.sh"
# shellcheck source=lib/commission/web.sh
. "$KC_LIB/web.sh"
# shellcheck source=lib/commission/nodes.sh
. "$KC_LIB/nodes.sh"

KC_BOOT_TIMEOUT="${KC_BOOT_TIMEOUT:-900}"
KC_MAIL_WAIT="${KC_MAIL_WAIT:-600}"
KC_CONSOLE_TIMEOUT="${KC_CONSOLE_TIMEOUT:-6}"
KC_CONSOLE_STEPS="${KC_CONSOLE_STEPS:-90}"
KC_POLL="${KC_POLL:-10}"
KC_NODE_WAIT="${KC_NODE_WAIT:-3600}"
KC_CT_OPTS="${KC_CT_OPTS:-}"
KC_KEEP=0
KC_SHOT=0

usage() {
    sed -n '/^# usage:/,/^#   --keep/s/^# \{0,1\}//p' "$0" >&2
    exit 2
}

die() {
    echo "keel-commission: $2" >&2
    exit "$1"
}

declare -A KC_SECRETS

# new_secret: 24 letters and digits, never a default and safe on a
# terminal.
new_secret() {
    local s=""
    # a password box of the first boot wants three kinds of characters
    # (password_problem of libinithooks): 24 letters and digits can come
    # with no digit or no capital, and the box asks again for ever (BR2,
    # 2026-11-06)
    until [[ $s =~ [A-Z] && $s =~ [a-z] && $s =~ [0-9] ]]; do
        s=$(LC_ALL=C tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 24)
    done
    printf '%s' "$s"
}

secret_value() {
    printf '%s' "${KC_SECRETS[$1]}"
}

# resolve ANSWER: a literal answer, or the value of "secret:NAME".
resolve() {
    case "$1" in
        secret:*) secret_value "${1#secret:}" ;;
        *) printf '%s' "$1" ;;
    esac
}

parse_args() {
    KC_CONTRACT="" KC_TEMPLATE="" KC_ISO="" KC_VMID="" KC_PASS="" KC_SITE="" KC_OUT=""
    KC_CHECK_ONLY=0
    while [ $# -gt 0 ]; do
        case "$1" in
            --check) KC_CHECK_ONLY=1; KC_CONTRACT="${2:-}"; shift ;;
            --contract) KC_CONTRACT="${2:-}"; shift ;;
            --template) KC_TEMPLATE="${2:-}"; shift ;;
            --iso) KC_ISO="${2:-}"; shift ;;
            --vmid) KC_VMID="${2:-}"; shift ;;
            --pass) KC_PASS="${2:-}"; shift ;;
            --site) KC_SITE="${2:-}"; shift ;;
            --out) KC_OUT="${2:-}"; shift ;;
            --keep) KC_KEEP=1 ;;
            *) usage ;;
        esac
        shift
    done
    [ -n "$KC_CONTRACT" ] || usage
    [ "$KC_CHECK_ONLY" = 1 ] && return 0
    if [ -z "$KC_SITE" ] || [ -z "$KC_OUT" ]; then
        usage
    fi
    [[ "$KC_VMID" =~ ^[1-9][0-9]{2,8}$ ]] || die 2 "--vmid '$KC_VMID' is not a container id"
    case "$KC_PASS" in
        lxc-interactive|lxc-preseed) KC_KIND=lxc KC_IMAGE="$KC_TEMPLATE" ;;
        vm-iso) KC_KIND=vm KC_IMAGE="$KC_ISO" ;;
        cloud_simple|cloud_advanced) KC_KIND=nodes KC_IMAGE=- ;;
        *) die 2 "--pass '$KC_PASS' is not lxc-interactive, lxc-preseed, vm-iso, cloud_simple or cloud_advanced" ;;
    esac
    [ -n "$KC_IMAGE" ] || die 2 "--pass $KC_PASS needs $([ "$KC_KIND" = vm ] && echo --iso || echo --template)"
    site_env "$KC_SITE"
    [ -n "${KC_PVE:-}" ] || die 2 "KC_PVE is not set: nothing reaches the PVE host"
    ntfy_env
    nameserver_env
}

# nameserver_env: each KC_NAMESERVER value is a list of addresses, checked
# before any machine is made. The value goes into the pct command line on
# the PVE host.
nameserver_env() {
    local var
    for var in $(compgen -v KC_NAMESERVER); do
        [[ ${!var} =~ ^[0-9A-Fa-f:.\ ]*$ ]] || die 2 "$var '${!var}' is not a list of addresses"
    done
}

# ntfy_env: the alert topic of a cloud pass, checked before any machine is
# made. A token file that others may read is refused: the token lets
# anybody write to the topic.
ntfy_env() {
    local f
    [ -n "${KC_NTFY_URL:-}" ] || return 0
    [[ $KC_NTFY_URL =~ ^https://[A-Za-z0-9.-]+(:[0-9]+)?/[A-Za-z0-9_-]{1,40}$ ]] \
        || die 2 "KC_NTFY_URL '$KC_NTFY_URL' is not https://HOST/TOPIC"
    for f in KC_NTFY_TOKEN_FILE KC_NTFY_READ_FILE; do
        [ -n "${!f:-}" ] || { [ "$f" = KC_NTFY_READ_FILE ] && continue; die 2 "$f is not set"; }
        [ -s "${!f}" ] || die 2 "$f '${!f}' is no file with a value"
        [[ $(stat -c %a "${!f}") =~ ^[46]00$ ]] || die 2 "$f '${!f}' may be read by others: it must be mode 600 or 400"
    done
}

load_contract() {
    KC_TSV=$(python3 -I "$KC_LIB/contract.py" tsv "$KC_CONTRACT") || exit 2
}

# questions_file FILE: one "ID<TAB>PROMPT<TAB>ANSWER<TAB>TYPE" line per
# question, with the answers resolved; the answer of a choice is a Tcl
# string body of its keys. A question that the node of a cloud mode answers
# with the same id is left out: the node's keys replace it. The expect
# script tries the questions first, so the Mode question of an app contract
# (Simple, by Enter) took the Mode screen of a cloud node (keel-core,
# 2026-11-06).
questions_file() {
    local rows row f answer own
    mapfile -t rows < <(grep $'^question\t' <<< "$KC_TSV")
    own=$(grep $'^answer\t'"${KC_NODE:-}"$'\t' <<< "$KC_TSV" | cut -f3)
    : > "$1"
    chmod 0600 "$1"
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r -a f <<< "$row"
        if [ -n "${KC_NODE:-}" ] && grep -qxF -- "${f[1]}" <<< "$own"; then
            continue
        fi
        if [ "${f[5]}" = choice ]; then
            answer=$(printf '%s' "${f[4]}" | python3 -I "$KC_LIB/contract.py" keys tcl)
        else
            answer=$(resolve "${f[4]}")
        fi
        printf '%s\t%s\t%s\t%s\n' "${f[1]}" "${f[3]}" "$answer" "${f[5]}" >> "$1"
    done
}

# answers_file FILE: the screens of this node (Mode, Role, Join a mesh,
# ...), one "ID<TAB>PROMPT<TAB>KEYS" line each, KEYS a Tcl string body
# with the secrets, the invite lines and the VIP filled in.
answers_file() {
    local row id prompt keys rows
    : > "$1"
    chmod 0600 "$1"
    mapfile -t rows < <(grep $'^answer\t'"${KC_NODE:-}"$'\t' <<< "$KC_TSV" | cut -f3-)
    for row in "${rows[@]}"; do
        IFS=$'\t' read -r id prompt keys <<< "$row"
        printf '%s\t%s\t%s\n' "$id" "$prompt" \
            "$(printf '%s' "$keys" | python3 -I "$KC_LIB/contract.py" keys tcl)" >> "$1"
    done
}

write_meta() {
    local sha contract
    sha=$(template_sha "$KC_IMAGE")
    contract=$(sha256sum "$KC_CONTRACT" | cut -d' ' -f1)
    # the release gate looks a template or an ISO up by its sha256
    printf 'pass\t%s\nsite\t%s\n%s\t%s\nsha256\t%s\ncontract\t%s\ndate\t%s\n' \
        "$KC_PASS" "$KC_SITE" "$([ "$KC_KIND" = vm ] && echo iso || echo template)" "$KC_IMAGE" \
        "$sha" "$contract" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$KC_DIR/meta"
}

pass_interactive() {
    local questions="$KC_WORK/questions" answers="$KC_WORK/answers" script="$KC_WORK/console.exp"
    # without expect the console is never driven, and every question would
    # fail as if keel-init had not asked it (BR1, 2026-11-05)
    pve 'command -v expect' >/dev/null || die 3 "the PVE host has no expect: apt-get install expect"
    ct_create "$KC_IMAGE" >/dev/null || die 3 "pct create failed"
    ct_start || die 3 "pct start failed"
    boot_or_fail || return 1
    questions_file "$questions"
    answers_file "$answers"
    console_script "$questions" "$answers" > "$script"
    console_run "$script" "$KC_LOG"
    console_parse "$KC_LOG" "$questions" "$answers"
    answers_table > "$KC_WORK/table"
    console_frames "${KC_LOG%.log}.txt" "$KC_WORK/table"
}

pass_preseed() {
    local root="$KC_WORK/root" hook rc=0
    (umask 077; python3 -I "$KC_LIB/contract.py" instance "$KC_CONTRACT" "$root") || rc=$?
    [ "$rc" = 0 ] || exit "$rc"
    ct_create "$KC_IMAGE" >/dev/null || die 3 "pct create failed"
    if ct_write_instance "$root"; then
        record pass instance.written /etc/keel/instance.yaml
    else
        record fail instance.written "could not write /etc/keel/instance.yaml"
    fi
    ct_start || die 3 "pct start failed"
    boot_or_fail || return 1
    local hooks
    mapfile -t hooks < <(grep $'^question\t' <<< "$KC_TSV" | cut -f3 | sort -u)
    for hook in "${hooks[@]}"; do
        check_not_deferred "$hook"
    done
}

boot_or_fail() {
    if ct_wait_firstboot; then
        record pass firstboot.finished "the first boot ran to its end"
        return 0
    fi
    record fail firstboot.finished "no end of the first boot after ${KC_BOOT_TIMEOUT}s"
    return 1
}

common_checks() {
    local kind a b c d e
    while IFS=$'\t' read -r kind a b c d e; do
        case "$kind" in
            proof) check_proof "$a" "$b" "$c" "$d" "$e" ;;
            service) check_service "$a" ;;
            url) check_url "$a" "$b" ;;
            forbid) check_forbid "$a" "$b" ;;
        esac
    done <<< "$KC_TSV"
    check_hygiene
    check_mail
}

# pass_one: the pass of one machine, from its creation to its removal.
pass_one() {
    local done=0
    case "$KC_PASS" in
        lxc-interactive) pass_interactive && done=1 ;;
        lxc-preseed) pass_preseed && done=1 ;;
        vm-iso) pass_vm && done=1 ;;
    esac
    # a machine that never finished its first boot has nothing to check
    if [ "$done" = 1 ] || [ "$KC_KIND" = lxc ]; then
        common_checks
        web_shots
    fi
    if [ "$KC_KIND" = vm ]; then vm_destroy; else ct_destroy; fi
}

main() {
    local name
    parse_args "$@"
    load_contract
    if [ "$KC_CHECK_ONLY" = 1 ]; then
        echo "keel-commission: $KC_CONTRACT is a valid contract"
        exit 0
    fi
    if [ "$KC_KIND" != nodes ] && pve "qm status $KC_VMID >/dev/null 2>&1 || pct status $KC_VMID >/dev/null 2>&1"; then
        die 4 "vmid $KC_VMID exists; keel-commission only uses a free id"
    fi
    local names
    mapfile -t names < <(grep $'^secret\t' <<< "$KC_TSV" | cut -f2)
    for name in "${names[@]}"; do
        KC_SECRETS[$name]=$(new_secret)
        export "KC_SECRET_$name=${KC_SECRETS[$name]}"
    done
    KC_LOGIN_SECRET=$(new_secret)
    KC_DIR="$KC_OUT/$KC_PASS"
    KC_RECORD="$KC_DIR/record.tsv"
    KC_LOG="$KC_DIR/console.log"
    KC_WORK=$(mktemp -d)
    trap 'rm -rf "$KC_WORK"' EXIT
    mkdir -p "$KC_DIR/screens"
    : > "$KC_RECORD"
    if [ "$KC_KIND" = nodes ]; then
        printf 'pass\t%s\nsite\t%s\ncontract\t%s\ndate\t%s\n' "$KC_PASS" "$KC_SITE" \
            "$(sha256sum "$KC_CONTRACT" | cut -d' ' -f1)" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" > "$KC_DIR/meta"
        pass_nodes
    else
        write_meta
        pass_one
    fi
    python3 -I "$KC_LIB/guide.py" "$KC_OUT"
    if grep -q $'^fail\t' "$KC_RECORD"; then
        printf 'result\tfail\n' >> "$KC_DIR/meta"
        echo "keel-commission: FAIL, $(grep -c $'^fail\t' "$KC_RECORD") checks failed: $KC_RECORD"
        exit 1
    fi
    printf 'result\tpass\n' >> "$KC_DIR/meta"
    echo "keel-commission: PASS: $KC_RECORD"
}

main "$@"
