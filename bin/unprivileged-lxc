#!/bin/bash
# unprivileged-lxc: run an appliance's tests/boot-test.sh on keel-lxc-1
# without root on the host.
#
#   unprivileged-lxc run SCRATCH -- COMMAND [ARGS...]
#   unprivileged-lxc cleanup SCRATCH
#
# Every appliance repository carries its own tests/boot-test.sh, nine of
# them on 2026-10-01 and no two alike, and every one of them refuses to run
# unless it is root: it assembles the layer chain with keel assemble, writes
# into the rootfs and starts the container itself. Until 2026-10-01 the
# runner reached root for that through sudo, which made any job on the
# runner root on the public services VM it shares with keellinux.org.
#
# `run` gives COMMAND a root it can have without the host's: a user
# namespace (lxc-usernsexec) in which uid 0 is the first id of the runner's
# subordinate range, the same range the container's lxc.idmap uses, so
# every file the assemble writes has the owner the container will see.
# The runner's own uid is mapped in as well, at ULX_IDS, so the job's
# workspace and scratch tree stay writable from inside.
#
# Root in that namespace cannot create a veth on the host bridge or move a
# process into the container's cgroup. The LXC commands of COMMAND are
# therefore links to this script that forward their arguments, and stdin
# for lxc-attach, to a broker this script starts outside the namespace, as
# the runner, which runs the real command as an unprivileged LXC user would:
# lxc-start with the idmap and an AppArmor profile an unprivileged user may
# apply, under a delegated systemd user scope; lxc-attach under a scope of
# the same user manager, so the attach may enter the container's cgroup.
# The broker runs with the runner's own rights and nothing more, so it is
# a convenience, not a privilege boundary.
#
# `tar` is a link too. Device nodes cannot be created in a user namespace,
# and a layer carries a few under /dev (null, zero, random, tty...). LXC
# mounts its own /dev over the rootfs when it starts the container, so
# those nodes are never seen. The link runs the real tar and forgives
# exactly that refusal, counting the nodes it skipped; any other error, or
# that one mixed with any other, fails as before.
#
# lxc-start is not forwarded straight away. The first time the broker is
# asked to start a container, it boots it once with the first boot units
# masked on the init command line (ULX_MASK), runs bin/upgrade-rootfs of
# this repository (ULX_UPGRADE) inside it through lxc-attach, and stops it;
# then it starts it as asked, and the first boot the test waits for runs
# on the upgraded system. The upgrade is apt-get full-upgrade from Debian
# and archive.keellinux.org trixie-testing, then the .deb files in
# ULX_DEBS, the packages built from the pull request, when the job has
# them. So the boot test boots "published layer + current testing + this
# pull request's package", what an operator has after `apt upgrade`, and a
# published layer whose first boot is broken no longer fails the pull
# request that fixes it (tracker#53). The maintainer scripts of those
# packages run inside the container, under its idmap, which does not map
# the runner, and the AppArmor profile of every other start; nothing of
# the upgrade runs on the runner. The upgrade boot leaves the first boot
# to come untouched: inithooks, the host keys and the init fence do not
# run, and systemd does not commit a machine id, so the next boot is still
# systemd's first boot. The versions that changed against the published
# layer go to the log and, under GitHub Actions, to the job summary.
#
# `cleanup` stops the broker and removes SCRATCH, which holds files owned
# by the subordinate range, through the same namespace.
set -euo pipefail
shopt -s inherit_errexit

ULX_IDS=65536
ULX_PROFILE=lxc-container-default-with-nesting
ULX_FORWARDED="lxc-attach lxc-destroy lxc-info lxc-ls lxc-start lxc-stop lxc-wait"
ULX_POLL=${ULX_POLL:-0.1}
ULX_UPGRADE=${ULX_UPGRADE:-$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/upgrade-rootfs}
ULX_DEBS=${ULX_DEBS-}
ULX_MASK="inithooks.service keel-host-keys.service turnkey-init-fence.service systemd-machine-id-commit.service"
ULX_TRIES=${ULX_TRIES:-90}
ULX_PAUSE=${ULX_PAUSE:-2}
ULX_PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ULX_INSIDE=/tmp/keel-ci-upgrade
ULX_ARCHIVE=${ULX_ARCHIVE:-https://archive.keellinux.org}
ULX_SUITES="trixie trixie-testing"
ULX_INDEX=main/binary-amd64/Packages
# A pool path as the archive's index names it, and nothing that climbs.
ULX_POOL='^pool/[A-Za-z0-9][A-Za-z0-9._+~/-]*\.deb$'
ULX_TAR=${ULX_TAR:-/usr/bin/tar}
ULX_SUBUID=${ULX_SUBUID:-/etc/subuid}
ULX_SUBGID=${ULX_SUBGID:-/etc/subgid}
# awk programs, single quoted so the shell leaves their fields alone.
# shellcheck disable=SC2016
ULX_RANGE='$1 == user && $3 >= need { print $2; exit }'
# tar names itself by argv[0], so the lines start with tar: or /usr/bin/tar:.
ULX_MKNOD='^[^ ]*tar: .*: Cannot mknod: Operation not permitted$'
ULX_TAR_END='^[^ ]*tar: Exiting with failure status due to previous errors$'
# shellcheck disable=SC2016
ULX_MKNOD_ONLY='$0 ~ mknod { n++; next } $0 !~ end { other = 1 } END { print n + 0; exit (other || n == 0) }'

ulx_die() {
    echo "unprivileged-lxc: $*" >&2
    exit 2
}

# ulx_subid FILE: the start of this user's first subordinate range in FILE,
# when it holds at least ULX_IDS ids.
ulx_subid() {
    local user start
    user=$(id -un)
    start=$(awk -F: -v user="$user" -v need="$ULX_IDS" "$ULX_RANGE" "$1")
    [ -n "$start" ] || ulx_die "$1 has no range of $ULX_IDS ids for $user"
    printf '%s\n' "$start"
}

# ulx_maps: the lxc-usernsexec mappings, the subordinate range at 0 and this
# user at ULX_IDS.
ulx_maps() {
    local uid gid
    uid=$(ulx_subid "$ULX_SUBUID")
    gid=$(ulx_subid "$ULX_SUBGID")
    printf '%s\n' -m "u:0:$uid:$ULX_IDS" -m "g:0:$gid:$ULX_IDS" \
        -m "u:$ULX_IDS:$(id -u):1" -m "g:$ULX_IDS:$(id -g):1"
}

# ulx_defines: what lxc-start is given on top of the config the boot test
# wrote, which was written for a privileged container.
ulx_defines() {
    local uid gid
    uid=$(ulx_subid "$ULX_SUBUID")
    gid=$(ulx_subid "$ULX_SUBGID")
    printf '%s\n' -s lxc.include=/usr/share/lxc/config/userns.conf \
        -s "lxc.idmap=u 0 $uid $ULX_IDS" -s "lxc.idmap=g 0 $gid $ULX_IDS" \
        -s "lxc.apparmor.profile=$ULX_PROFILE" -s lxc.apparmor.allow_nesting=0
}

ulx_scratch() {
    [[ ${1-} == /* ]] || ulx_die "SCRATCH must be an absolute path, not '${1-}'"
    case "$1" in
        *..*|/) ulx_die "refusing SCRATCH '$1'" ;;
    esac
}

# --- outside the namespace --------------------------------------------

ulx_run() {
    local scratch=$1 dir self command rc=0 maps
    shift
    [ "${1-}" = -- ] && shift
    [ $# -gt 0 ] || ulx_die "run needs a command after --"
    dir=$scratch/userns
    self=$(readlink -f "${BASH_SOURCE[0]}")
    mkdir -p "$dir/bin" "$dir/requests"
    for command in $ULX_FORWARDED tar; do
        ln -sfn "$self" "$dir/bin/$command"
    done
    rm -f "$dir/fifo"
    mkfifo -m 0600 "$dir/fifo"
    export XDG_RUNTIME_DIR=${XDG_RUNTIME_DIR:-/run/user/$(id -u)}
    # Through a variable, not < <(...): a process substitution that fails
    # leaves the array empty and set -e none the wiser.
    maps=$(ulx_maps)
    mapfile -t maps <<< "$maps"
    "$self" broker "$scratch" &
    echo "$!" > "$dir/broker.pid"
    ULX_DIR=$dir ULX_BROKER=$! PATH="$dir/bin:$PATH" \
        lxc-usernsexec "${maps[@]}" -- "$@" || rc=$?
    ulx_stop_broker "$dir"
    return "$rc"
}

ulx_stop_broker() {
    local pid
    [ -r "$1/broker.pid" ] || return 0
    pid=$(cat "$1/broker.pid")
    kill "$pid" 2>/dev/null || true
    rm -f "$1/broker.pid"
}

ulx_broker() {
    local dir=$1/userns id
    exec 3<>"$dir/fifo"
    while IFS= read -r id <&3; do
        case "$id" in
            ''|*[!A-Za-z0-9]*) echo "unprivileged-lxc: ignoring request '$id'" >&2 ;;
            *) ulx_serve "$dir/requests/$id" & ;;
        esac
    done
}

ulx_serve() {
    local request=$1 command input=/dev/null rc=0 defines
    local -a argv
    mapfile -d '' -t argv < "$request/argv"
    command=${argv[0]}
    [ -e "$request/in" ] && input=$request/in
    [[ " $ULX_FORWARDED " == *" $command "* ]] || command=""
    case "$command" in
        lxc-start)
            defines=$(ulx_defines)
            mapfile -t defines <<< "$defines"
            ulx_upgrade "${request%/requests/*}" "${argv[@]:1}" \
                && systemd-run --user --scope --quiet -p Delegate=yes -- \
                    lxc-start "${defines[@]}" "${argv[@]:1}" ;;
        lxc-attach)
            systemd-run --user --scope --quiet -- "${argv[@]}" ;;
        '')
            echo "unprivileged-lxc: ${argv[0]} is not forwarded" >&2
            false ;;
        *)
            "${argv[@]}" ;;
    esac < "$input" > "$request/out" 2> "$request/err" || rc=$?
    echo "$rc" > "$request/rc.tmp"
    mv "$request/rc.tmp" "$request/rc"
}

# --- the upgrade before the first boot, outside the namespace -----------

ulx_say() {
    echo "unprivileged-lxc: $*" >&2
}

# ulx_ct PATH NAME COMMAND...: COMMAND as root in the container, in a clean
# environment.
ulx_ct() {
    local path=$1 name=$2
    shift 2
    systemd-run --user --scope --quiet -- \
        lxc-attach -P "$path" -n "$name" --clear-env -- \
        env PATH="$ULX_PATH" LANG=C.UTF-8 DEBIAN_FRONTEND=noninteractive HOME=/root "$@"
}

# ulx_settled PATH NAME: systemd has finished starting and the network
# answers.
ulx_settled() {
    local state
    state=$(ulx_ct "$1" "$2" systemctl is-system-running < /dev/null 2>/dev/null) || true
    case "$state" in running|degraded) ;; *) return 1 ;; esac
    ulx_ct "$1" "$2" getent ahosts deb.debian.org < /dev/null > /dev/null 2>&1
}

# ulx_fetch URL FILE: one file of the archive, over https only.
ulx_fetch() {
    curl -fsS --proto =https --retry 2 --retry-delay 3 --create-dirs -o "$2" "$1" \
        || { ulx_say "cannot fetch $1"; return 1; }
}

# ulx_mirror DIR: the signed indexes of the archive's suites and every
# package they name, under DIR/archive, fetched by the runner. The
# containers on lxcbr0 cannot reach archive.keellinux.org, which this same
# machine serves (refused on its public IPv4 address, dropped on its IPv6
# one; measured 2026-10-03), while the runner reaches it through its own
# hosts entry, as it reaches the mirror. Nothing here is trusted: apt in the
# container checks InRelease against the image's keyring and every file
# against InRelease.
ulx_mirror() {
    local root=$1/archive suite file names
    local -a files
    rm -rf "$root"
    for suite in $ULX_SUITES; do
        ulx_fetch "$ULX_ARCHIVE/dists/$suite/InRelease" "$root/dists/$suite/InRelease" || return 1
        ulx_fetch "$ULX_ARCHIVE/dists/$suite/$ULX_INDEX" "$root/dists/$suite/$ULX_INDEX" || return 1
        names=$(awk '$1 == "Filename:" { print $2 }' "$root/dists/$suite/$ULX_INDEX")
        mapfile -t files <<< "$names"
        for file in "${files[@]}"; do
            if [[ ! $file =~ $ULX_POOL ]] || [[ $file == *..* ]]; then
                ulx_say "the $suite index names '$file', not a pool file"
                return 1
            fi
            [ -e "$root/$file" ] || ulx_fetch "$ULX_ARCHIVE/$file" "$root/$file" || return 1
        done
    done
    # apt reads them as _apt in the container, whatever the runner's umask.
    chmod -R a+rX "$root"
}

# ulx_upgrade_boot DIR PATH NAME DEFINES...: the upgrade boot itself, the
# container running with the first boot masked.
ulx_upgrade_boot() {
    local dir=$1 path=$2 name=$3 try deb unit masked
    local -a mask=() debs=() inside=()
    shift 3
    for unit in $ULX_MASK; do mask+=("systemd.mask=$unit"); done
    systemd-run --user --scope --quiet -p Delegate=yes -- \
        lxc-start "$@" -s "lxc.init.cmd=/sbin/init ${mask[*]}" -P "$path" -n "$name" -d \
        || { ulx_say "the upgrade boot of $name did not start"; return 1; }
    lxc-wait -P "$path" -n "$name" -s RUNNING -t 60 \
        || { ulx_say "$name did not reach RUNNING for the upgrade"; return 1; }
    for ((try = 0; try < ULX_TRIES; try++)); do
        ! ulx_settled "$path" "$name" || break
        sleep "$ULX_PAUSE"
    done
    [ "$try" -lt "$ULX_TRIES" ] \
        || { ulx_say "$name did not settle with a network for the upgrade"; return 1; }
    # shellcheck disable=SC2086
    masked=$(ulx_ct "$path" "$name" systemctl is-enabled $ULX_MASK < /dev/null 2>&1 | sort -u) || true
    [ "$masked" = masked-runtime ] \
        || { ulx_say "the first boot of $name is not held: $(tr '\n' ' ' <<< "$masked")"; return 1; }
    # shellcheck disable=SC2016
    tar -C "$dir/archive" -cf - . | ulx_ct "$path" "$name" sh -c 'mkdir -p "$1" && tar -C "$1" --no-same-owner -xf -' sh "$ULX_INSIDE/archive" \
        || { ulx_say "the archive could not be copied into $name"; return 1; }
    [ -z "$ULX_DEBS" ] || debs=("$ULX_DEBS"/*.deb)
    for deb in "${debs[@]+"${debs[@]}"}"; do
        # shellcheck disable=SC2016
        ulx_ct "$path" "$name" sh -c 'mkdir -p "$1" && cat > "$1/$2"' sh "$ULX_INSIDE/debs" "${deb##*/}" < "$deb" \
            || { ulx_say "${deb##*/} could not be copied into $name"; return 1; }
        inside+=("$ULX_INSIDE/debs/${deb##*/}")
    done
    ulx_ct "$path" "$name" bash -s -- "${inside[@]+"${inside[@]}"}" < "$ULX_UPGRADE" > "$dir/upgraded/$name.changes" \
        || { ulx_say "the upgrade inside $name failed"; return 1; }
}

# ulx_summary COUNT NAME CHANGES: the job summary's section on a container.
ulx_summary() {
    echo "### $2, upgraded before its first boot"
    echo
    echo "$1 packages differ from the published layer, from Debian,"
    echo "archive.keellinux.org trixie-testing and this run's packages."
    echo
    [ "$1" -gt 0 ] || return 0
    echo "| Package | Published | Booted |"
    echo "| --- | --- | --- |"
    awk -F'\t' '{ printf "| `%s` | `%s` | `%s` |\n", $1, $2, $3 }' "$3"
    echo
}

# ulx_report DIR NAME: the versions that changed, to the log and the summary.
ulx_report() {
    local changes=$1/upgraded/$2.changes count
    count=$(grep -c . "$changes" || true)
    ulx_say "$2: $count packages differ from the published layer"
    awk -F'\t' '{ printf "  %s %s -> %s\n", $1, $2, $3 }' "$changes" >&2
    [ -z "${GITHUB_STEP_SUMMARY-}" ] || ulx_summary "$count" "$2" "$changes" >> "$GITHUB_STEP_SUMMARY"
}

# ulx_upgrade DIR LXC-START-ARGS...: before the first start of a container
# in this run, the upgrade boot. True when the container may be started.
ulx_upgrade() {
    local dir=$1 path="" name="" rc=0 defines
    shift
    while [ $# -gt 0 ]; do
        case "$1" in
            -P|--lxcpath) path=${2-}; shift ;;
            --lxcpath=*) path=${1#*=} ;;
            -n|--name) name=${2-}; shift ;;
            --name=*) name=${1#*=} ;;
        esac
        shift
    done
    if [ -z "$path" ] || [[ ! $name =~ ^[A-Za-z0-9_][A-Za-z0-9_.-]*$ ]]; then
        ulx_say "lxc-start: -P and a plain -n are needed to upgrade the container first"
        return 1
    fi
    [ ! -e "$dir/upgraded/$name.changes" ] || return 0
    if [ -n "$ULX_DEBS" ] && ! compgen -G "$ULX_DEBS/*.deb" > /dev/null; then
        ulx_say "ULX_DEBS is $ULX_DEBS, which holds no .deb; $name is not started"
        return 1
    fi
    mkdir -p "$dir/upgraded"
    if [ ! -e "$dir/archive/dists" ]; then
        ulx_say "fetching $ULX_ARCHIVE $ULX_SUITES for the upgrades"
        ulx_mirror "$dir" || { ulx_say "lxc-start: $name is not started"; return 1; }
    fi
    ulx_say "upgrading $name before its first boot"
    defines=$(ulx_defines)
    mapfile -t defines <<< "$defines"
    ulx_upgrade_boot "$dir" "$path" "$name" "${defines[@]}" || rc=1
    lxc-stop -P "$path" -n "$name" -t 30 > /dev/null 2>&1 \
        || lxc-stop -P "$path" -n "$name" -k > /dev/null 2>&1 || true
    if [ "$rc" -ne 0 ]; then
        rm -f "$dir/upgraded/$name.changes"
        ulx_say "lxc-start: $name is not started"
        return 1
    fi
    ulx_report "$dir" "$name"
}

ulx_cleanup() {
    local scratch=$1 maps
    ulx_stop_broker "$scratch/userns"
    [ -e "$scratch" ] || return 0
    maps=$(ulx_maps)
    mapfile -t maps <<< "$maps"
    lxc-usernsexec "${maps[@]}" -- rm -rf -- "$scratch"
}

# --- inside the namespace ---------------------------------------------

ulx_client() {
    local name=$1 request rc
    shift
    if [ -z "${ULX_DIR-}" ] || [ -z "${ULX_BROKER-}" ]; then
        ulx_die "$name: not under 'unprivileged-lxc run'"
    fi
    request=$(mktemp -d "$ULX_DIR/requests/XXXXXXXX")
    printf '%s\0' "$name" "$@" > "$request/argv"
    if [ "$name" = lxc-attach ] && { [ -p /dev/stdin ] || [ -f /dev/stdin ]; }; then
        cat > "$request/in"
    fi
    chown -R "${ULX_OWNER:-$ULX_IDS:$ULX_IDS}" "$request"
    echo "${request##*/}" > "$ULX_DIR/fifo"
    until [ -e "$request/rc" ]; do
        [ -d "/proc/$ULX_BROKER" ] || ulx_die "$name: the broker has gone away"
        sleep "$ULX_POLL"
    done
    cat "$request/out"
    cat "$request/err" >&2
    rc=$(cat "$request/rc")
    rm -rf "$request"
    return "$rc"
}

# ulx_mknod_only: stdin is tar's stderr; true when every complaint in it is
# a device node the namespace may not create. Prints how many.
ulx_mknod_only() {
    awk -v mknod="$ULX_MKNOD" -v end="$ULX_TAR_END" "$ULX_MKNOD_ONLY"
}

ulx_tar() {
    local err rc=0 skipped
    err=$(mktemp)
    "$ULX_TAR" "$@" 2> "$err" || rc=$?
    if [ "$rc" -eq 2 ] && skipped=$(ulx_mknod_only < "$err"); then
        echo "unprivileged-lxc: tar skipped $skipped device nodes; LXC mounts its own /dev" >&2
        rc=0
    else
        cat "$err" >&2
    fi
    rm -f "$err"
    return "$rc"
}

ulx_main() {
    local name
    name=$(basename "$0")
    case "$name" in
        tar) ulx_tar "$@"; return ;;
        lxc-*) ulx_client "$name" "$@"; return ;;
    esac
    case "${1-}" in
        run|cleanup|broker)
            ulx_scratch "${2-}"
            "ulx_$1" "${@:2}" ;;
        *)
            echo "usage: unprivileged-lxc run SCRATCH -- COMMAND [ARGS...]" >&2
            echo "       unprivileged-lxc cleanup SCRATCH" >&2
            return 2 ;;
    esac
}

ulx_main "$@"
